{
  "name": "cvs-night-shift",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "편의점 야간근무 — 새벽 3시, 혼자 남았다. 웹 랜덤 디펜스 게임",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.functions.json",
    "test": "vitest run",
    "sim": "tsx scripts/sim.ts",
    "deploy:cf": "npm run build && npx wrangler pages deploy dist --project-name=cvs-night-shift",
    "pacing": "tsx scripts/pacing.ts",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "test:controls": "node scripts/playtest-controls.mjs",
    "test:resume": "node scripts/playtest-resume.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
